{
  "name": "aws-order-system-mcp",
  "version": "2.0.0",
  "private": true,
  "description": "MCP server for the AWS order system. HTTP mode for web UI. stdio mode for MCP Inspector.",
  "main": "mcp_server.js",
  "scripts": {
    "start":        "node mcp_server.js --http",
    "mcp:inspect":  "set DANGEROUSLY_OMIT_AUTH=true && npx @modelcontextprotocol/inspector node mcp_server.js --stdio"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb":  "^3.918.0",
    "@aws-sdk/lib-dynamodb":     "^3.918.0",
    "@google/generative-ai":     "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express":                   "^4.21.2",
    "zod":                       "^3.23.8"
  }
}
