# ─── AWS Configuration ────────────────────────────────────────────────────────
AWS_REGION=us-east-1
ORDERS_TABLE=orders-table

# ─── API Gateway ──────────────────────────────────────────────────────────────
# POST  /order  → place a new order
# GET   /order/{order_id} → fetch order by ID
ORDER_API_URL=https://7j1c9xj6gi.execute-api.us-east-1.amazonaws.com/prod/order

# ─── Gemini AI ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── MCP Server Transport ─────────────────────────────────────────────────────
# Transport: "stdio" (MCP Inspector / Claude Desktop) | "http" (web clients)
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
MCP_ALLOWED_ORIGIN=*
